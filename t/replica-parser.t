use strict;
use warnings;
use utf8;
use Test::More;
use File::Temp qw(tempdir);
use MIME::Base64 qw(encode_base64);
use Encode qw(encode);
use JMAP::ReplicaParser;
my $dir=tempdir(CLEANUP=>1);
my $header=encode_base64(encode('UTF-8','Счёт за заказ'),'');
open my $f,'>:raw',"$dir/test.eml" or die $!;
print {$f} "Subject: =?UTF-8?B?$header?=\r\nFrom: Test <test\@example.invalid>\r\nMIME-Version: 1.0\r\nContent-Type: multipart/mixed; boundary=x\r\n\r\n";
print {$f} "--x\r\nContent-Type: text/html; charset=UTF-8\r\n\r\n",encode('UTF-8','<style>hidden</style><p>Оплата заказа 123</p><script>secret()</script>'),"\r\n";
print {$f} "--x\r\nContent-Type: application/octet-stream\r\nContent-Disposition: attachment; filename=invoice.pdf\r\nContent-Transfer-Encoding: base64\r\n\r\n",encode_base64('binary-secret'x100000),"\r\n--x--\r\n";
close $f;
my $doc=JMAP::ReplicaParser->parse("$dir/test.eml",spool=>$dir);
like($doc->{subject},qr/Счёт за заказ/,'encoded Cyrillic subject decoded');
like($doc->{body},qr/Оплата заказа 123/,'HTML body yields Unicode text');
unlike($doc->{body},qr/secret|hidden|binary/,'scripts/styles/binary attachments excluded');
like($doc->{attachments},qr/invoice.pdf/,'attachment filename searchable');
eval {JMAP::ReplicaParser->parse("$dir/test.eml",spool=>$dir,max_text_bytes=>3)};
like($@,qr/text budget/,'oversize extracted text is explicit failure, not silently truncated');
opendir my $d,$dir or die $!;my @temporary=grep {/^jmap-mime-/} readdir($d);closedir $d;
is(scalar @temporary,0,'per-job MIME scratch is removed on both success and failure');
done_testing;
