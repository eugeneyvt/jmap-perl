use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use JMAP::Replica;
my $dir=tempdir(CLEANUP=>1);
my $r=JMAP::Replica->new(path=>"$dir/replica.sqlite3");
my $identity=$r->enqueue({folder=>1,uidvalidity=>5,uid=>7,bytes=>99,msgid=>'old-stable-id'});
is($r->enqueue({folder=>1,uidvalidity=>5,uid=>7,bytes=>99,msgid=>'old-stable-id'}),$identity,'enqueue replay preserves identity');
eval {$r->enqueue({folder=>1,uidvalidity=>5,uid=>7,bytes=>100,msgid=>'old-stable-id'})};
like($@,qr/metadata changed/,'changed immutable UID is explicit failure');
my $job=$r->claim;
is($job->{attempts},1,'claim increments durable attempts');
ok(!$r->claim,'active lease prevents duplicate acquisition');
eval {$r->complete($job,{body=>'hello'})};like($@,qr/Raw manifest required/,'indexing cannot precede verified raw');
$r->raw_saved($job,{sha256=>'a'x64,bytes=>99});
$r->{dbh}->do('UPDATE replica_jobs SET lease_until=0');
eval {$r->complete($job,{body=>'hello'})};like($@,qr/lease lost/,'expired owner cannot publish an index');
my $retry=$r->claim;
is($retry->{sha256},'a'x64,'raw manifest survives worker loss');
is($retry->{attempts},2,'expired lease is replayed');
$r->complete($retry,{body=>'hello',subject=>'a'});
is($r->state->{generation},1,'document and generation commit together');
ok(!$r->claim,'completed work is never redownloaded');
$r->seal_catalog('catalog',1);
$r->set_mode('local','catalog');
ok($r->coverage('catalog')->{ready},'verified full catalog can enter local mode');
ok(!$r->coverage('new-mail')->{ready},'new catalog invalidates completeness');
eval {$r->set_mode('local','new-mail')};like($@,qr/coverage incomplete/,'switch refuses an incomplete catalog');
$r->enqueue({folder=>2,uidvalidity=>5,uid=>8,bytes=>99,msgid=>'old-stable-id'});
my $collision=$r->claim;
$r->raw_saved($collision,{sha256=>'b'x64,bytes=>99});
eval {$r->complete($collision,{body=>'different'})};like($@,qr/identity collision/,'legacy message-ID collisions cannot overwrite indexed content');
is($r->state->{generation},2,'failed index transaction does not advance generation');
$r->fail($collision,'identity_collision');
ok(!$r->claim,'failed job backs off durably');
done_testing;
