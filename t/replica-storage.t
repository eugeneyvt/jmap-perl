use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use Digest::SHA qw(sha256_hex);
use Cwd qw(abs_path);
use JMAP::RawStore;
my $dir=abs_path(tempdir(CLEANUP=>1));mkdir "$dir/box";
my $available=1;
my $store=JMAP::RawStore->new(root=>"$dir/box",account=>'one',guard=>sub {$available});
open my $f,'>:raw',"$dir/source" or die $!;print {$f} "synthetic\0raw\r\n";close $f;
my $manifest=$store->publish("$dir/source",15);
is($manifest->{sha256},sha256_hex("synthetic\0raw\r\n"),'raw bytes have verified SHA256');
is($manifest->{bytes},15,'exact octet count retained');
my $path=$store->verified_path($manifest->{sha256},15);
ok(-f $path,'content-addressed object published');
is_deeply($store->publish("$dir/source",15),$manifest,'replayed publish is idempotent');
eval {$store->publish("$dir/source",16)};like($@,qr/Incomplete/,'incomplete source cannot be committed');
$available=0;eval {$store->publish("$dir/source",15)};like($@,qr/mount unavailable/,'missing mount fails closed');
$available=1;
my $other=JMAP::RawStore->new(root=>"$dir/box",account=>'two',guard=>sub {1});
eval {$other->verified_path($manifest->{sha256},15)};like($@,qr/missing/,'another account cannot read a manifest by hash');
open $f,'>:raw',$path or die $!;print {$f} 'corrupt';close $f;
eval {$store->publish("$dir/source",15)};like($@,qr/checksum mismatch/,'existing corrupted raw is preserved and reported, never overwritten');
eval {$store->verified_path('../escape',1)};like($@,qr/Invalid content hash/,'path traversal rejected');
done_testing;
